// Trade Flow v2 - Database Schema (Prisma)
// Follows Rule A3: pooled connection with DIRECT_URL for migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users table (Rule B1)
model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  userCompanies      UserCompany[]
  refreshTokens      RefreshToken[]
  stockLedgerEntries StockLedger[]
  createdPurchases   Purchase[]
  createdInvoices    Invoice[]
  createdReturns     PurchaseReturn[]
  createdSettlements SupplierSettlement[]
  payments           Payment[]

  @@map("users")
}

// 2. Companies table
model Company {
  id            String         @id @default(uuid())
  name          String
  gstin         String?
  drugLicenseNo String?        @map("drug_license_no")
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  userCompanies   UserCompany[]
  items           Item[]
  batches         Batch[]
  parties         Party[]
  stockLedger     StockLedger[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  invoices        Invoice[]
  settlements     SupplierSettlement[]
  payments        Payment[]

  @@map("companies")
}

// 3. User-Company Junction Table (Roles: owner, accountant, salesperson)
model UserCompany {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  role      String   // "owner" | "accountant" | "salesperson"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

// 4. Refresh Tokens (Rule B2)
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// 5. Login Rate Limiting in Database (Rule B4)
model LoginAttempt {
  id             String    @id @default(uuid())
  username       String
  ipAddress      String    @map("ip_address")
  failedAttempts Int       @default(1) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([username, ipAddress])
  @@map("login_attempts")
}

// 6. Supabase Heartbeat Table (Rule F4)
model Heartbeat {
  id          Int      @id @default(1)
  lastSeen    DateTime @default(now()) @map("last_seen")
  serviceName String   @default("tradeflow-backend") @map("service_name")
  metadata    Json?    @default("{}")

  @@map("heartbeat")
}

// 7. Idempotency Keys (Rule F3)
model IdempotencyKey {
  key          String   @id
  endpoint     String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("idempotency_keys")
}

// ==========================================
// PHASE 1: MASTER DATA & INVENTORY SCHEMA
// ==========================================

// 8. Medicine / Item Catalog
model Item {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  sku              String
  name             String
  genericName      String?  @map("generic_name")
  manufacturer     String?
  hsnCode          String   @default("3004") @map("hsn_code")
  gstRate          Decimal  @default(5.0) @map("gst_rate") @db.Decimal(5, 2)
  unit             String   @default("STRIP") // STRIP, TAB, BOTTLE, VIAL, BOX
  conversionFactor Int      @default(1) @map("conversion_factor")
  minStockLevel    Int      @default(0) @map("min_stock_level")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches             Batch[]
  stockLedger         StockLedger[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  invoiceItems        InvoiceItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("items")
}

// 9. Batch & Expiry Master
model Batch {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  itemId       String   @map("item_id")
  batchNumber  String   @map("batch_number")
  expiryDate   DateTime @map("expiry_date")
  mrp          Decimal  @map("mrp") @db.Decimal(10, 2)
  ptr          Decimal  @map("ptr") @db.Decimal(10, 2) // Price To Retailer (Cost Price)
  pts          Decimal  @map("pts") @db.Decimal(10, 2) // Price To Stockist (Selling Price)
  currentStock Int      @default(0) @map("current_stock") // in base units
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockLedger         StockLedger[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  invoiceItems        InvoiceItem[]

  @@unique([companyId, itemId, batchNumber])
  @@index([companyId, expiryDate])
  @@map("batches")
}

// 10. Parties Master (Suppliers & Customers / Ledger Master)
model Party {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  name               String
  type               String    // "supplier" | "customer" | "both"
  station            String?
  accountGroup       String?   @map("account_group") // "SUNDRY_CREDITORS", "SUNDRY_DEBTORS", "BANK", "CASH"
  balancingMethod    String    @default("BILL_BY_BILL") @map("balancing_method") // "BILL_BY_BILL", "ON_ACCOUNT"
  openingBalance     Decimal   @default(0.0) @map("opening_balance") @db.Decimal(12, 2)
  openingBalanceType String    @default("CR") @map("opening_balance_type") // "DR" | "CR"
  mailTo             String?   @map("mail_to")
  address            String?
  pincode            String?
  state              String?
  stateCode          String?   @map("state_code")
  country            String    @default("INDIA")
  phone              String?
  mobile             String?
  faxNo              String?   @map("fax_no")
  email              String?
  website            String?
  contactPerson      String?   @map("contact_person")
  designation        String?
  gstin              String?
  drugLicenseNo      String?   @map("drug_license_no")
  dlExpiryDate       DateTime? @map("dl_expiry_date")
  fssaiNo            String?   @map("fssai_no")
  fssaiExpiryDate    DateTime? @map("fssai_expiry_date")
  panNo              String?   @map("pan_no")
  scheduleHNotice    String    @default("ALLOW_ALL") @map("schedule_h_notice") // "ALLOW_ALL", "WARNING", "BLOCK"
  holdPayment        Boolean   @default(false) @map("hold_payment")
  ledgerCategory     String    @default("REGISTERED") @map("ledger_category") // "REGISTERED", "UNREGISTERED", "COMPOSITE", "CONSUMER"
  defaultDoctorName  String?   @map("default_doctor_name")
  defaultDoctorRegNo String?   @map("default_doctor_reg_no")
  isCash             Boolean   @default(false) @map("is_cash")
  creditLimit        Decimal   @default(0.0) @map("credit_limit") @db.Decimal(12, 2)
  outstandingBalance Decimal   @default(0.0) @map("outstanding_balance") @db.Decimal(12, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  invoices        Invoice[]
  settlements     SupplierSettlement[]
  payments        Payment[]

  @@unique([companyId, name, type])
  @@index([companyId, type])
  @@map("parties")
}

// 11. Append-Only Stock Audit Ledger (Rule E)
model StockLedger {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  itemId      String   @map("item_id")
  batchId     String   @map("batch_id")
  entryType   String   @map("entry_type") // OPENING_BALANCE, PURCHASE, SALE, PURCHASE_RETURN, SALE_RETURN, ADJUSTMENT
  quantity    Int      // Positive for inward, Negative for outward
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  referenceId String?  @map("reference_id")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyId, itemId])
  @@index([companyId, batchId])
  @@map("stock_ledger")
}

// ==========================================
// PHASE 2: PURCHASES & INWARD STOCK SCHEMA
// ==========================================

// 12. Purchase Inward Bills
model Purchase {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  supplierId    String    @map("supplier_id")
  invoiceNumber String    @map("invoice_number")
  purchaseDate  DateTime  @map("purchase_date")
  dueDate       DateTime? @map("due_date")
  paymentMode   String    @default("CREDIT") @map("payment_mode") // CASH, CREDIT, BANK_TRANSFER, CHEQUE, UPI
  subtotal      Decimal   @default(0.0) @map("subtotal") @db.Decimal(12, 2)
  totalDiscount Decimal   @default(0.0) @map("total_discount") @db.Decimal(12, 2)
  taxableAmount Decimal   @default(0.0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount    Decimal   @default(0.0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal   @default(0.0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount    Decimal   @default(0.0) @map("igst_amount") @db.Decimal(12, 2)
  roundOff      Decimal   @default(0.0) @map("round_off") @db.Decimal(5, 2)
  totalAmount   Decimal   @default(0.0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal   @default(0.0) @map("paid_amount") @db.Decimal(12, 2)
  status        String    @default("UNPAID") // PAID, PARTIAL, UNPAID
  notes         String?
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Party          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creator  User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items    PurchaseItem[]
  payments Payment[]

  @@unique([companyId, supplierId, invoiceNumber])
  @@index([companyId, purchaseDate])
  @@index([companyId, status])
  @@map("purchases")
}

// 13. Purchase Itemized Rows
model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseId      String   @map("purchase_id")
  itemId          String   @map("item_id")
  batchId         String   @map("batch_id")
  pack            String?  @default("10 TAB")
  batchNumber     String   @map("batch_number")
  expiryDate      DateTime @map("expiry_date")
  quantity        Int
  freeQuantity    Int      @default(0) @map("free_quantity")
  purchaseRate    Decimal  @map("purchase_rate") @db.Decimal(10, 2) // PTR
  mrp             Decimal  @map("mrp") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0.0) @map("discount_percent") @db.Decimal(5, 2)
  taxableValue    Decimal  @map("taxable_value") @db.Decimal(10, 2)
  gstRate         Decimal  @default(5.0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount       Decimal  @map("gst_amount") @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([itemId])
  @@index([batchId])
  @@map("purchase_items")
}

// ==========================================
// PHASE 3: SALES BILLING, POS & GST INVOICING
// ==========================================

// 14. Sales Invoices
model Invoice {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  partyId         String?   @map("party_id")
  invoiceNumber   String    @map("invoice_number")
  invoiceDate     DateTime  @map("invoice_date")
  dueDate         DateTime? @map("due_date")
  customerName    String    @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  customerAddress String?   @map("customer_address")
  customerGstin   String?   @map("customer_gstin")
  doctorName      String?   @map("doctor_name")
  doctorRegNo     String?   @map("doctor_reg_no")
  patientName     String?   @map("patient_name")
  patientAddress  String?   @map("patient_address")
  paymentMode     String    @default("CASH") @map("payment_mode") // CASH, UPI, CARD, CREDIT, SPLIT
  subtotal        Decimal   @default(0.0) @map("subtotal") @db.Decimal(12, 2)
  itemDiscount    Decimal   @default(0.0) @map("item_discount") @db.Decimal(12, 2)
  billDiscountPct Decimal   @default(0.0) @map("bill_discount_pct") @db.Decimal(5, 2)
  billDiscountAmt Decimal   @default(0.0) @map("bill_discount_amt") @db.Decimal(12, 2)
  taxableAmount   Decimal   @default(0.0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount      Decimal   @default(0.0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount      Decimal   @default(0.0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount      Decimal   @default(0.0) @map("igst_amount") @db.Decimal(12, 2)
  totalTax        Decimal   @default(0.0) @map("total_tax") @db.Decimal(12, 2)
  roundOff        Decimal   @default(0.0) @map("round_off") @db.Decimal(5, 2)
  grandTotal      Decimal   @default(0.0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0.0) @map("paid_amount") @db.Decimal(12, 2)
  status          String    @default("PAID") // PAID, PARTIAL, UNPAID
  notes           String?
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party    Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  creator  User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, invoiceDate])
  @@index([companyId, status])
  @@index([companyId, partyId])
  @@map("invoices")
}

// 15. Invoice Itemized Rows
model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  itemId          String   @map("item_id")
  batchId         String   @map("batch_id")
  pack            String?  @default("10 TAB")
  batchNumber     String   @map("batch_number")
  expiryDate      DateTime @map("expiry_date")
  strips          Int      @default(0)
  looseQty        Int      @default(0) @map("loose_qty")
  quantity        Int      // Total base units (strips * conversionFactor + looseQty)
  freeQuantity    Int      @default(0) @map("free_quantity")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2) // MRP or Rate charged
  mrp             Decimal  @map("mrp") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0.0) @map("discount_percent") @db.Decimal(5, 2)
  taxableAmount   Decimal  @map("taxable_amount") @db.Decimal(10, 2)
  gstRate         Decimal  @default(5.0) @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal  @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount      Decimal  @map("sgst_amount") @db.Decimal(10, 2)
  igstAmount      Decimal  @map("igst_amount") @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemId])
  @@index([batchId])
  @@map("invoice_items")
}

// 16. Purchase Returns / Supplier Debit Notes (CN)
model PurchaseReturn {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  supplierId    String   @map("supplier_id")
  returnNumber  String   @map("return_number") // e.g. "CN-2026-0001" or "PR-2026-0001"
  returnDate    DateTime @map("return_date")
  subtotal      Decimal  @default(0.0) @map("subtotal") @db.Decimal(12, 2)
  taxableAmount Decimal  @default(0.0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount    Decimal  @default(0.0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0.0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount    Decimal  @default(0.0) @map("igst_amount") @db.Decimal(12, 2)
  roundOff      Decimal  @default(0.0) @map("round_off") @db.Decimal(5, 2)
  totalAmount   Decimal  @default(0.0) @map("total_amount") @db.Decimal(12, 2)
  reason        String?  // "EXPIRED_STOCK", "SLOW_MOVING", "DAMAGED", "OVERSTOCK"
  notes         String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Party                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creator  User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items    PurchaseReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, returnDate])
  @@index([companyId, supplierId])
  @@map("purchase_returns")
}

// 17. Purchase Return Itemized Rows
model PurchaseReturnItem {
  id               String   @id @default(uuid())
  purchaseReturnId String   @map("purchase_return_id")
  itemId           String   @map("item_id")
  batchId          String   @map("batch_id")
  pack             String?  @default("10 TAB")
  batchNumber      String   @map("batch_number")
  expiryDate       DateTime @map("expiry_date")
  strips           Int      @default(0)
  looseQty         Int      @default(0) @map("loose_qty")
  quantity         Int      // Total base units returned
  returnRate       Decimal  @map("return_rate") @db.Decimal(10, 2) // PTR/Cost
  mrp              Decimal  @map("mrp") @db.Decimal(10, 2)
  taxableValue     Decimal  @map("taxable_value") @db.Decimal(10, 2)
  gstRate          Decimal  @default(0.0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount        Decimal  @map("gst_amount") @db.Decimal(10, 2)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(10, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
  @@index([itemId])
  @@index([batchId])
  @@map("purchase_return_items")
}

// 18. Supplier & Manufacturer Pay-on-Sale Settlements
model SupplierSettlement {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  settlementNumber String   @map("settlement_number")
  manufacturer     String?
  supplierId       String?  @map("supplier_id")
  periodStartDate  DateTime @map("period_start_date")
  periodEndDate    DateTime @map("period_end_date")
  grossSoldUnits   Int      @default(0) @map("gross_sold_units")
  returnedUnits    Int      @default(0) @map("returned_units")
  netSoldUnits     Int      @default(0) @map("net_sold_units")
  grossPayableCost Decimal  @default(0.0) @map("gross_payable_cost") @db.Decimal(12, 2)
  returnDeduction  Decimal  @default(0.0) @map("return_deduction") @db.Decimal(12, 2)
  netPayableAmount Decimal  @default(0.0) @map("net_payable_amount") @db.Decimal(12, 2)
  retailSalesValue Decimal  @default(0.0) @map("retail_sales_value") @db.Decimal(12, 2)
  realizedMargin   Decimal  @default(0.0) @map("realized_margin") @db.Decimal(12, 2)
  paidAmount       Decimal  @default(0.0) @map("paid_amount") @db.Decimal(12, 2)
  paymentMode      String   @default("BANK_TRANSFER") @map("payment_mode")
  paymentRef       String?  @map("payment_ref")
  status           String   @default("SETTLED")
  settlementDate   DateTime @default(now()) @map("settlement_date")
  itemDetails      Json?    @map("item_details")
  notes            String?
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Party?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([companyId, settlementNumber])
  @@index([companyId, settlementDate])
  @@index([companyId, manufacturer])
  @@index([companyId, supplierId])
  @@map("supplier_settlements")
}

// 19. Payments & Vouchers (Cash, Bank, UPI towards Purchases or Invoices)
model Payment {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  partyId     String    @map("party_id")
  purchaseId  String?   @map("purchase_id")
  invoiceId   String?   @map("invoice_id")
  voucherNo   String    @map("voucher_no")
  paymentType String    @map("payment_type") // "PAYMENT_OUT" (paid to supplier) | "PAYMENT_IN" (received from customer)
  amount      Decimal   @db.Decimal(12, 2)
  paymentDate DateTime  @default(now()) @map("payment_date")
  paymentMode String    @default("CASH") @map("payment_mode") // CASH, UPI, BANK_TRANSFER, CHEQUE
  referenceNo String?   @map("reference_no")
  notes       String?
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party    Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyId, partyId])
  @@index([companyId, paymentDate])
  @@index([companyId, purchaseId])
  @@index([companyId, invoiceId])
  @@map("payments")
}


# PharmaFlow v2 Environment Configuration
PORT=5001
NODE_ENV=development

# Database Connection (Supabase PostgreSQL Connection String)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Heartbeat Security Key (Rule F4 & F5)
# Set a strong random secret key. Cron-job.org and /health/heartbeat will use this key.
HEARTBEAT_KEY=pharmaflow-live-heartbeat-secret-key-2026

# Region Configuration (Rule F7)
# Render: Singapore (singapore)
# Supabase: Singapore (ap-southeast-1) or Mumbai (ap-south-1)
APP_REGION=Singapore
